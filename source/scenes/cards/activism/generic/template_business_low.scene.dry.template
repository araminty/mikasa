@local_campaign
title: [District] business campaign
subtitle: Ding Big 3 prosperity, help city
choose-if: month_actions_remaining > 0
unavailable-subtitle: No organizing actions left this month.
on-arrival: {!
Q.spendGenericAction();
const groupProsperity = Q.prosperity_business || 5;
const scale = 0.1 + (groupProsperity / 20);
Q.prosperity_soylent = Math.max(0, (Number(Q.prosperity_soylent) || 0) - scale * 0.4);
Q.prosperity_magrail = Math.max(0, (Number(Q.prosperity_magrail) || 0) - scale * 0.4);
Q.prosperity_brazos = Math.max(0, (Number(Q.prosperity_brazos) || 0) - scale * 0.4);
Q.prosperity_citywide = (Number(Q.prosperity_citywide) || 0) + (scale * 0.5);
if (typeof Q.syncProsperityDisplays === 'function') { Q.syncProsperityDisplays() }
!}

[FLAVOR: Coordinated boycotts, shared supplier networks, unified bargaining]

@anti_racket_pledge
title: Anti-racket pledge
subtitle: Tank syndicate illegal prosperity in [DISTRICT]
choose-if: month_actions_remaining > 0 and Q.syndicate_power_[DISTRICT] < 0.5 and Q.police_corruption_[DISTRICT] < 0.5
unavailable-subtitle: [! if Q.syndicate_power_[DISTRICT] >= 0.5: Syndicates too powerful ?][! if Q.police_corruption_[DISTRICT] >= 0.5: Police too corrupt ?][! if month_actions_remaining <= 0: No organizing actions left ?]
on-arrival: {!
Q.spendGenericAction();
Q.syndicate_illegal_[DISTRICT] = Math.max(0, (Number(Q.syndicate_illegal_[DISTRICT]) || 0) - 1.0);
Q.anti_racket_[DISTRICT] = (Number(Q.anti_racket_[DISTRICT]) || 0) + 1;
!}

[FLAVOR: Public refusal to pay protection money, collective security]
